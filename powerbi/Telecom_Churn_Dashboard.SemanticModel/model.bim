        "partitions": [
          {
            "name": "dim_customer",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"dim_customer.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"customer_id\", type text}, {\"geo_key\", type text}, {\"gender\", type text}, {\"age\", Int64.Type}, {\"age_band\", type text}, {\"senior_citizen\", Int64.Type}, {\"partner\", type text}, {\"dependents\", type text}, {\"join_date\", type date}, {\"acquisition_channel\", type text}, {\"service_type\", type text}, {\"plan_id\", type text}, {\"network_type\", type text}, {\"contract_type\", type text}, {\"payment_method\", type text}, {\"paperless_billing\", type text}, {\"ott_bundle\", type text}, {\"device_protection\", type text}, {\"intl_roaming\", type text}, {\"priority_support\", type text}, {\"multi_line\", type text}, {\"addon_count\", Int64.Type}, {\"discount_pct\", type number}, {\"monthly_charges\", Currency.Type}, {\"charge_band\", type text}, {\"tenure_months\", Int64.Type}, {\"tenure_band\", type text}, {\"churn\", type text}, {\"churn_flag\", Int64.Type}, {\"churn_date\", type date}, {\"churn_reason\", type text}, {\"customer_status\", type text}}, \"en-US\"),",
                "    Add_tenure_band_sort = Table.AddColumn(Typed, \"tenure_band_sort\", each if [tenure_band] = \"0-6 M\" then 1 else if [tenure_band] = \"7-12 M\" then 2 else if [tenure_band] = \"13-24 M\" then 3 else if [tenure_band] = \"25-48 M\" then 4 else 5, Int64.Type),",
                "    Add_charge_band_sort = Table.AddColumn(Add_tenure_band_sort, \"charge_band_sort\", each if [charge_band] = \"< 300\" then 1 else if [charge_band] = \"300-600\" then 2 else if [charge_band] = \"600-1000\" then 3 else 4, Int64.Type),",
                "    Clean = Table.ReplaceValue(Add_charge_band_sort, \"\", null, Replacer.ReplaceValue, {\"churn_reason\"})",
                "in",
                "    Clean"
              ],
              "type": "m"
            }
          }
        ]
      },
