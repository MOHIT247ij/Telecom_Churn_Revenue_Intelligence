            "lineageTag": "536c41cd-3a3b-4a96-9207-1ad0cee0313a",
            "sourceColumn": "cumulative_revenue_lost",
            "summarizeBy": "sum"
          }
        ],
        "lineageTag": "2f997b8d-f0b5-4ad4-b72c-c21d9c980e2c",
        "partitions": [
          {
            "name": "fact_monthly_kpis",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fact_monthly_kpis.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"month\", type date}, {\"opening_subscribers\", Int64.Type}, {\"new_subscribers\", Int64.Type}, {\"churned_subscribers\", Int64.Type}, {\"closing_subscribers\", Int64.Type}, {\"churn_rate\", type number}, {\"mrr\", Currency.Type}, {\"collected\", Currency.Type}, {\"collection_efficiency\", type number}, {\"late_payment_rate\", type number}, {\"billed_subscribers\", Int64.Type}, {\"churned_mrr\", Currency.Type}, {\"new_mrr\", Currency.Type}, {\"arpu\", Currency.Type}, {\"mrr_growth_pct\", type number}, {\"net_subscriber_adds\", Int64.Type}, {\"cumulative_revenue_lost\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Save Rate",
        "columns": [
          {
            "name": "Save Rate",
            "dataType": "double",
            "formatString": "0%",
            "lineageTag": "76c6acdb-11a9-4931-adeb-4a4b93f9bdc4",
            "sourceColumn": "Save Rate",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "311c1056-264c-4fa6-b2c5-d75a106e391e",
        "measures": [
          {
            "name": "Save Rate Value",
            "expression": "SELECTEDVALUE ( 'Save Rate'[Save Rate], 0.3 )",
            "formatString": "0%",
            "lineageTag": "fea699bf-1664-4c91-8ef9-ba05b4284d2f"
          }
        ],
        "partitions": [
          {
            "name": "Save Rate",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromList(List.Transform({2..12}, each _ * 0.05), Splitter.SplitByNothing(), {\"Save Rate\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Save Rate\", type number}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Offer Cost",
        "columns": [
          {
            "name": "Offer Cost",
            "dataType": "double",
            "formatString": "₹#,0",
            "lineageTag": "182ed78a-7b44-411e-bb01-aab3ad9b65df",
            "sourceColumn": "Offer Cost",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "278a30ec-9ff1-4f87-a9e9-7ce9816501a0",
        "measures": [
          {
            "name": "Offer Cost Value",
            "expression": "SELECTEDVALUE ( 'Offer Cost'[Offer Cost], 300 )",
            "formatString": "₹#,0",
            "lineageTag": "45d91cb5-801d-47cc-bb66-acc8a46e62e4"
          }
        ],
        "partitions": [
          {
            "name": "Offer Cost",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromList(List.Transform({2..16}, each _ * 50), Splitter.SplitByNothing(), {\"Offer Cost\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Offer Cost\", type number}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Dummy",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "71a482eb-49a1-42fd-a0f4-840153ce53b1",
            "sourceColumn": "Dummy",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "fcc9cab1-ba8a-45a4-b8eb-6d17cd303305",
        "measures": [
          {
            "name": "Total Customers",
            "displayFolder": "01 Customers",
            "expression": "DISTINCTCOUNT ( dim_customer[customer_id] )",
            "formatString": "#,0",
            "lineageTag": "875dbc36-962f-4b4f-8f2c-c44b7dcaf36d"
          },
          {
            "name": "Churned Customers",
            "displayFolder": "01 Customers",
            "expression": "CALCULATE ( [Total Customers], dim_customer[churn_flag] = 1 )",
            "formatString": "#,0",
            "lineageTag": "566fd924-1aeb-4a25-a350-b297687f761c"
          },
          {
            "name": "Active Customers",
            "displayFolder": "01 Customers",
            "expression": "CALCULATE ( [Total Customers], dim_customer[churn_flag] = 0 )",
            "formatString": "#,0",
            "lineageTag": "3dc886a1-8f02-435a-9537-7d3f3f064b61"
          },
          {
            "name": "Churn Rate %",
            "displayFolder": "01 Customers",
            "expression": "DIVIDE ( [Churned Customers], [Total Customers] )",
            "formatString": "0.0%",
            "lineageTag": "74c26db3-480c-44d6-84c6-50782ce0daf2"
          },
          {
            "name": "Retention Rate %",
            "displayFolder": "01 Customers",
            "expression": "1 - [Churn Rate %]",
            "formatString": "0.0%",
            "lineageTag": "b8a97c10-350b-48b0-897e-3838baa08b4c"
          },
          {
            "name": "Avg Tenure (Months)",
            "displayFolder": "01 Customers",
            "expression": "AVERAGE ( dim_customer[tenure_months] )",
            "formatString": "0.0",
            "lineageTag": "c4a88964-b268-4f99-9669-e5d365644eff"
          },
          {
            "name": "Churn Lift vs Avg",
            "displayFolder": "01 Customers",
            "expression": [
              "    VAR _all = CALCULATE ( [Churn Rate %], ALLSELECTED ( dim_customer ) )",
              "    RETURN DIVIDE ( [Churn Rate %], _all )"
            ],
            "formatString": "0.00",
            "lineageTag": "d6a82411-4d17-4a10-8f61-a1bf9dafff38"
          },
          {
            "name": "New Subscribers",
            "displayFolder": "02 Subscriber Movement",
            "expression": [
              "    CALCULATE (",
              "        COUNTROWS ( dim_customer ),",
              "        USERELATIONSHIP ( dim_customer[join_date], dim_date[date] )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "8cf20887-ece5-4cb5-8860-cf21105d34ef"
          },
          {
            "name": "Churned in Period",
            "displayFolder": "02 Subscriber Movement",
            "expression": [
              "    CALCULATE (",
              "        COUNTROWS ( dim_customer ),",
              "        USERELATIONSHIP ( dim_customer[churn_date], dim_date[date] ),",
              "        dim_customer[churn_flag] = 1",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "eecc5dad-16be-4984-a498-e6fdddf60193"
          },
          {
            "name": "Net Adds",
            "displayFolder": "02 Subscriber Movement",
            "expression": "[New Subscribers] - [Churned in Period]",
            "formatString": "#,0",
            "lineageTag": "8c4f5732-f727-4761-827a-24652f3275e1"
          },
          {
            "name": "Opening Subscribers",
            "displayFolder": "02 Subscriber Movement",
            "expression": [
              "    VAR _start = MIN ( dim_date[date] )",
              "    RETURN",
              "        CALCULATE (",
              "            COUNTROWS ( dim_customer ),",
              "            REMOVEFILTERS ( dim_date ),",
              "            dim_customer[join_date] < _start,",
              "            ISBLANK ( dim_customer[churn_date] ) || dim_customer[churn_date] >= _start",
              "        )"
            ],
            "formatString": "#,0",
            "lineageTag": "ef4ae52d-237b-4cee-bc36-1b956cf0087f"
          },
          {
            "name": "Closing Subscribers",
            "displayFolder": "02 Subscriber Movement",
            "expression": "[Opening Subscribers] + [New Subscribers] - [Churned in Period]",
            "formatString": "#,0",
            "lineageTag": "e18dd5bc-df8e-4ed7-b852-a3f1f0f7cf40"
          },
          {
            "name": "Monthly Churn Rate %",
            "displayFolder": "02 Subscriber Movement",
            "expression": "DIVIDE ( [Churned in Period], [Opening Subscribers] )",
            "formatString": "0.0%",
            "lineageTag": "73fd5bf2-f04c-472e-a82a-69343bb7e0d1"
          },
          {
            "name": "Avg Monthly Churn Rate %",
            "displayFolder": "02 Subscriber Movement",
            "expression": "AVERAGEX ( VALUES ( dim_date[year_month] ), [Monthly Churn Rate %] )",
            "formatString": "0.0%",
            "lineageTag": "cf3e23f5-4fe5-46bb-9b45-2e302391c3fc"
          },
          {
            "name": "Total Revenue",
            "displayFolder": "03 Revenue",
            "expression": "SUM ( fact_billing[amount_billed] )",
            "formatString": "₹#,0",
            "lineageTag": "b3eaccf3-813d-4734-af60-e57cadca5f60"
          },
          {
            "name": "Revenue Collected",
            "displayFolder": "03 Revenue",
            "expression": "SUM ( fact_billing[amount_paid] )",
            "formatString": "₹#,0",
            "lineageTag": "8dfbe484-04cb-44d0-a332-4746f5b7b142"
          },
          {
            "name": "Outstanding Amount",
            "displayFolder": "03 Revenue",
            "expression": "SUM ( fact_billing[outstanding] )",
            "formatString": "₹#,0",
            "lineageTag": "28896633-214e-42dc-b6b3-43e09e8c6d45"
          },
          {
            "name": "Collection Efficiency %",
            "displayFolder": "03 Revenue",
            "expression": "DIVIDE ( [Revenue Collected], [Total Revenue] )",
            "formatString": "0.0%",
            "lineageTag": "d33960fa-352d-41bf-b659-25108617bf2b"
          },
          {
            "name": "Billed Subscribers",
            "displayFolder": "03 Revenue",
            "expression": "DISTINCTCOUNT ( fact_billing[customer_id] )",
            "formatString": "#,0",
            "lineageTag": "f794d876-874c-41dd-be68-a11004dbac0d"
          },
          {
            "name": "ARPU",
            "displayFolder": "03 Revenue",
            "expression": [
              "    DIVIDE (",
              "        [Total Revenue],",
              "        SUMX ( VALUES ( dim_date[year_month] ), CALCULATE ( [Billed Subscribers] ) )",
              "    )"
            ],
            "formatString": "₹#,0",
            "lineageTag": "2ea362ae-8b35-4bcd-bc9f-d010c716ff9e"
          },
          {
            "name": "Avg Monthly Revenue (MRR)",
            "displayFolder": "03 Revenue",
            "expression": "AVERAGEX ( VALUES ( dim_date[year_month] ), [Total Revenue] )",
            "formatString": "₹#,0",
            "lineageTag": "63482265-d76c-40e0-97a5-f0f72f921bb1"
          },
          {
            "name": "Revenue PM",
            "displayFolder": "03 Revenue",
            "expression": "CALCULATE ( [Total Revenue], DATEADD ( dim_date[date], -1, MONTH ) )",
            "formatString": "₹#,0",
            "lineageTag": "08b5987a-adca-466a-83c1-1747ce51f7f5"
          },
          {
            "name": "Revenue MoM %",
            "displayFolder": "03 Revenue",
            "expression": "DIVIDE ( [Total Revenue] - [Revenue PM], [Revenue PM] )",
            "formatString": "0.0%",
            "lineageTag": "573fec55-ab37-4fee-b920-23dc272fb8cf"
          },
          {
            "name": "Revenue PY",
            "displayFolder": "03 Revenue",
            "expression": "CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )",
            "formatString": "₹#,0",
            "lineageTag": "a7f13c0d-6e03-45b0-9ebc-c865629bdbcf"
          },
          {
            "name": "Revenue YoY %",
            "displayFolder": "03 Revenue",
            "expression": "DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )",
            "formatString": "0.0%",
            "lineageTag": "8079e485-3061-4004-8ff3-5f6d20d42913"
          },
          {
            "name": "Revenue FYTD",
            "displayFolder": "03 Revenue",
            "expression": "TOTALYTD ( [Total Revenue], dim_date[date], \"3/31\" )",
            "formatString": "₹#,0",
            "lineageTag": "eb75415e-8cd1-432f-83cb-45bde23efae2"
          },
          {
            "name": "Revenue Running Total",
            "displayFolder": "03 Revenue",
            "expression": [
              "    CALCULATE (",
              "        [Total Revenue],",
              "        FILTER ( ALL ( dim_date[date] ), dim_date[date] <= MAX ( dim_date[date] ) )",
              "    )"
            ],
            "formatString": "₹#,0",
            "lineageTag": "ee650f92-f0f9-4692-9b95-95d16e6d5c1b"
          },
          {
            "name": "Late Payment Rate %",
            "displayFolder": "03 Revenue",
            "expression": [
              "    DIVIDE (",
              "        CALCULATE ( COUNTROWS ( fact_billing ), fact_billing[payment_status] = \"Paid Late\" ),",
              "        COUNTROWS ( fact_billing )",
              "    )"
            ],
            "formatString": "0.0%",
            "lineageTag": "36d26260-83ca-49c8-96fb-c099cce59904"
          },
          {
            "name": "MRR Lost to Churn",
            "displayFolder": "04 Revenue Leakage",
            "expression": [
              "    CALCULATE (",
              "        SUM ( dim_customer[monthly_charges] ),",
              "        USERELATIONSHIP ( dim_customer[churn_date], dim_date[date] ),",
              "        dim_customer[churn_flag] = 1",
              "    )"
            ],
            "formatString": "₹#,0",
            "lineageTag": "86d46658-c127-4c6a-accf-f72897ea6db7"
          },
          {
            "name": "Annualised Revenue Lost",
            "displayFolder": "04 Revenue Leakage",
            "expression": "[MRR Lost to Churn] * 12",
            "formatString": "₹#,0",
            "lineageTag": "5f8d947b-bac8-4af1-a8e3-3c58ce2c088b"
          },
          {
            "name": "Cumulative MRR Lost",
            "displayFolder": "04 Revenue Leakage",
            "expression": [
              "    CALCULATE (",
              "        [MRR Lost to Churn],",
              "        FILTER ( ALL ( dim_date[date] ), dim_date[date] <= MAX ( dim_date[date] ) )",
              "    )"
            ],
            "formatString": "₹#,0",
            "lineageTag": "fdfddd07-535c-4872-bde4-7e5fc6ac4ea7"
          },
          {
            "name": "New MRR",
            "displayFolder": "04 Revenue Leakage",
            "expression": [
              "    CALCULATE (",
              "        SUM ( dim_customer[monthly_charges] ),",
              "        USERELATIONSHIP ( dim_customer[join_date], dim_date[date] )",
              "    )"
            ],
            "formatString": "₹#,0",
            "lineageTag": "081a2767-12c9-4598-8311-ed52d9205f8c"
          },
          {
            "name": "Net New MRR",
            "displayFolder": "04 Revenue Leakage",
            "expression": "[New MRR] - [MRR Lost to Churn]",
            "formatString": "₹#,0",
            "lineageTag": "22a59521-f757-4779-9975-66a1d38a6bf4"
          },
          {
            "name": "Top 20% Revenue Share",
            "displayFolder": "04 Revenue Leakage",
            "expression": [
              "    VAR _n = ROUNDUP ( [Billed Subscribers] * 0.2, 0 )",
              "    VAR _top =",
              "        TOPN ( _n, VALUES ( fact_billing[customer_id] ), CALCULATE ( [Total Revenue] ), DESC )",
              "    RETURN DIVIDE ( CALCULATE ( [Total Revenue], _top ), [Total Revenue] )"
            ],
            "formatString": "0.0%",
            "lineageTag": "966b9b18-d216-43cf-b3e2-96dac6aeab8a"
          },
          {
            "name": "Revenue at Risk",
            "displayFolder": "05 Predictive Risk",
            "expression": "SUM ( fact_churn_predictions[revenue_at_risk] )",
            "formatString": "₹#,0",
            "lineageTag": "d10192a2-399b-42cf-bef7-08dfb7f96423"
          },
          {
            "name": "Scored Customers",
            "displayFolder": "05 Predictive Risk",
            "expression": "COUNTROWS ( fact_churn_predictions )",
            "formatString": "#,0",
            "lineageTag": "8c77c208-5277-443c-819a-11cbbb227974"
          },
          {
            "name": "High Risk Customers",
            "displayFolder": "05 Predictive Risk",
            "expression": "CALCULATE ( [Scored Customers], fact_churn_predictions[risk_tier] = \"High\" )",
            "formatString": "#,0",
            "lineageTag": "b494cb9c-a1da-4267-9209-915934107a00"
          },
          {
            "name": "Medium Risk Customers",
            "displayFolder": "05 Predictive Risk",
            "expression": "CALCULATE ( [Scored Customers], fact_churn_predictions[risk_tier] = \"Medium\" )",
            "formatString": "#,0",
            "lineageTag": "172a7004-9362-4143-8d99-ecccf726c9b0"
          },
          {
            "name": "High Risk Revenue",
            "displayFolder": "05 Predictive Risk",
            "expression": "CALCULATE ( [Revenue at Risk], fact_churn_predictions[risk_tier] = \"High\" )",
            "formatString": "₹#,0",
            "lineageTag": "33b9da2d-aa8b-4d94-8e2d-fd9c9f3bfae1"
          },
          {
            "name": "Avg Churn Probability",
            "displayFolder": "05 Predictive Risk",
            "expression": "AVERAGE ( fact_churn_predictions[churn_probability] )",
            "formatString": "0.0%",
            "lineageTag": "220465e6-2a6b-40a3-a5c1-f976bc12b9d9"
          },
          {
            "name": "Avg Predicted CLV",
            "displayFolder": "05 Predictive Risk",
            "expression": "AVERAGE ( fact_churn_predictions[predicted_clv] )",
            "formatString": "₹#,0",
            "lineageTag": "41360eb9-8e49-4adf-b5d3-2eb5daad6dd9"
          },
          {
            "name": "Revenue at Risk % of Annual",
            "displayFolder": "05 Predictive Risk",
            "expression": "DIVIDE ( [Revenue at Risk], SUM ( fact_churn_predictions[annual_revenue] ) )",
            "formatString": "0.0%",
            "lineageTag": "5d813268-71ad-48cb-b23e-cacb22a09207"
          },
          {
            "name": "Targeted Customers",
            "displayFolder": "06 Retention Campaign ROI",
            "expression": "CALCULATE ( [Scored Customers], fact_churn_predictions[risk_tier] IN { \"High\", \"Medium\" } )",
            "formatString": "#,0",
            "lineageTag": "31e55b43-9a4e-4bf6-8df2-3242bb6933a9"
          },
          {
            "name": "Campaign Cost",
            "displayFolder": "06 Retention Campaign ROI",
            "expression": "[Targeted Customers] * 'Offer Cost'[Offer Cost Value]",
            "formatString": "₹#,0",
            "lineageTag": "38e0e0c0-a1e4-4aeb-adb2-372402eed7d6"
          },
          {
            "name": "Revenue Saved (Gross Margin)",
            "displayFolder": "06 Retention Campaign ROI",
            "expression": [
              "    CALCULATE ( [Revenue at Risk], fact_churn_predictions[risk_tier] IN { \"High\", \"Medium\" } )",
              "        * 'Save Rate'[Save Rate Value] * 0.40"
            ],
            "formatString": "₹#,0",
            "lineageTag": "4640c5e1-dc4b-46f2-9728-d5a450768df1"
          },
          {
            "name": "Campaign Net Benefit",
            "displayFolder": "06 Retention Campaign ROI",
            "expression": "[Revenue Saved (Gross Margin)] - [Campaign Cost]",
            "formatString": "₹#,0",
            "lineageTag": "cb7eab40-c388-4a68-aec6-936a08e4c948"
          },
          {
            "name": "Campaign ROI %",
            "displayFolder": "06 Retention Campaign ROI",
            "expression": "DIVIDE ( [Campaign Net Benefit], [Campaign Cost] )",
            "formatString": "0.0%",
            "lineageTag": "55da44bb-ba1b-4221-89aa-aeaa8f728cc2"
          },
          {
            "name": "Total Tickets",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "COUNTROWS ( fact_tickets )",
            "formatString": "#,0",
            "lineageTag": "5eff3a3f-7c20-4576-9158-5d9573829c7b"
          },
          {
            "name": "Avg CSAT",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "AVERAGE ( fact_tickets[csat_score] )",
            "formatString": "0.00",
            "lineageTag": "33dba3d3-c58d-4164-bfae-998d7f1f4198"
          },
          {
            "name": "Avg Resolution Hours",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "AVERAGE ( fact_tickets[resolution_hours] )",
            "formatString": "0.0",
            "lineageTag": "191592c6-5795-4fd9-99e1-8054b8a7ddf1"
          },
          {
            "name": "Resolution Rate %",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "DIVIDE ( SUM ( fact_tickets[resolved_flag] ), [Total Tickets] )",
            "formatString": "0.0%",
            "lineageTag": "a1d64470-f057-4ab4-b181-f9b15637d60f"
          },
          {
            "name": "Tickets per 100 Customers",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "DIVIDE ( [Total Tickets], [Billed Subscribers] ) * 100",
            "formatString": "0.0",
            "lineageTag": "5faa40dc-4d10-44d1-832c-1a64b391d0d3"
          },
          {
            "name": "Network Ticket Share %",
            "displayFolder": "07 Customer Experience & Network",
            "expression": [
              "    DIVIDE (",
              "        CALCULATE ( [Total Tickets],",
              "            fact_tickets[category] IN { \"Network / Coverage\", \"Slow Data Speed\", \"Broadband Outage\" } ),",
              "        [Total Tickets]",
              "    )"
            ],
            "formatString": "0.0%",
            "lineageTag": "35a3bf46-4017-4d94-b86c-1ab3bd775ff3"
          },
          {
            "name": "Avg Call Drop Rate %",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "AVERAGE ( fact_usage[call_drop_rate_pct] ) / 100",
            "formatString": "0.0%",
            "lineageTag": "ebf16386-ea42-46a3-ab56-cb36959b4b57"
          },
          {
            "name": "Avg Speed (Mbps)",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "AVERAGE ( fact_usage[avg_speed_mbps] )",
            "formatString": "0.0",
            "lineageTag": "5281c58d-9e24-43c9-a422-3fc68f526a73"
          },
          {
            "name": "Avg Data per User (GB)",
            "displayFolder": "07 Customer Experience & Network",
            "expression": "AVERAGE ( fact_usage[data_used_gb] )",
            "formatString": "0.0",
            "lineageTag": "87612a69-ab36-442b-bff1-5e4b48e5682c"
          },
          {
            "name": "Title Executive",
            "displayFolder": "08 UX helpers - dynamic titles & conditional colours",
            "expression": [
              "    \"Telecom Performance  |  \"",
              "        & IF ( ISFILTERED ( dim_geography[circle] ),",
              "               CONCATENATEX ( VALUES ( dim_geography[circle] ), dim_geography[circle], \", \" ),",
              "               \"All Circles\" )",
              "        & \"  |  \" & FORMAT ( MIN ( dim_date[date] ), \"MMM-yy\" ) & \" to \" & FORMAT ( MAX ( dim_date[date] ), \"MMM-yy\" )"
            ],
            "lineageTag": "166a5941-3347-46ae-98e2-55a025206646"
          },
          {
            "name": "Churn Colour",
            "displayFolder": "08 UX helpers - dynamic titles & conditional colours",
            "expression": [
              "    SWITCH ( TRUE (),",
              "        [Churn Lift vs Avg] >= 1.3, \"#E34948\",",
              "        [Churn Lift vs Avg] >= 1.0, \"#EDA100\",",
              "        \"#1BAF7A\" )"
            ],
            "lineageTag": "a18bf935-2651-4238-a4da-8733c8df53dd"
          },
          {
            "name": "KPI Revenue Arrow",
            "displayFolder": "08 UX helpers - dynamic titles & conditional colours",
            "expression": "IF ( [Revenue MoM %] >= 0, \"▲ \", \"▼ \" ) & FORMAT ( ABS ( [Revenue MoM %] ), \"0.0%\" ) & \" MoM\"",
            "lineageTag": "2cf15b50-7fbd-4b1a-9262-6d367977c462"
          },
          {
            "name": "Last Refresh",
            "displayFolder": "08 UX helpers - dynamic titles & conditional colours",
            "expression": "\"Data as of \" & FORMAT ( MAX ( fact_billing[bill_month] ), \"MMM yyyy\" )",
            "lineageTag": "2484e8ca-a96e-49cf-8ac6-37d0474bdeb1"
          },
          {
            "name": "Customer Plan",
            "displayFolder": "09 Customer 360",
            "expression": "SELECTEDVALUE ( dim_customer[plan_id], \"Select a customer\" )",
            "lineageTag": "b9cda4fb-6058-4ee0-ae71-12fe3a00cd8b"
          },
          {
            "name": "Customer Contract",
            "displayFolder": "09 Customer 360",
            "expression": "SELECTEDVALUE ( dim_customer[contract_type], \"-\" )",
            "lineageTag": "2dea30c5-cd66-47f6-a70d-806119e23050"
          },
          {
            "name": "Customer Tenure (M)",
            "displayFolder": "09 Customer 360",
            "expression": "IF ( HASONEVALUE ( dim_customer[customer_id] ), MAX ( dim_customer[tenure_months] ) )",
            "formatString": "0",
            "lineageTag": "3d25e478-4d76-4c1c-abee-8602ef144179"
          },
          {
            "name": "Customer Monthly Charge",
            "displayFolder": "09 Customer 360",
            "expression": "IF ( HASONEVALUE ( dim_customer[customer_id] ), MAX ( dim_customer[monthly_charges] ) )",
            "formatString": "₹#,0",
            "lineageTag": "293f5502-a0bb-47f0-8113-ed6b7ec9be2f"
          },
          {
            "name": "Customer Churn Probability",
            "displayFolder": "09 Customer 360",
            "expression": "IF ( HASONEVALUE ( dim_customer[customer_id] ), MAX ( fact_churn_predictions[churn_probability] ) )",
            "formatString": "0.0%",
            "lineageTag": "e47474b5-39e5-4c33-b166-beaa96c6687e"
          },
          {
            "name": "Customer Risk Tier",
            "displayFolder": "09 Customer 360",
            "expression": "IF ( HASONEVALUE ( dim_customer[customer_id] ), COALESCE ( MAX ( fact_churn_predictions[risk_tier] ), \"Already churned\" ) )",
            "lineageTag": "6c930e62-7205-4c73-a7c7-f7fe2c444787"
          },
          {
            "name": "Customer Next Action",
            "displayFolder": "09 Customer 360",
            "expression": "IF ( HASONEVALUE ( dim_customer[customer_id] ), COALESCE ( MAX ( fact_churn_predictions[next_best_action] ), \"-\" ) )",
            "lineageTag": "6cd7e1b0-5fa8-433f-9de9-86fba21c7010"
          },
          {
            "name": "Customer Status",
            "displayFolder": "09 Customer 360",
            "expression": "SELECTEDVALUE ( dim_customer[customer_status], \"-\" )",
            "lineageTag": "8c9e97c6-3855-420a-b093-15afd2dc6621"
          },
          {
            "name": "Total Data Used (GB)",
            "displayFolder": "09 Customer 360",
            "expression": "SUM ( fact_usage[data_used_gb] )",
            "formatString": "#,0.0",
            "lineageTag": "f505e243-ecd6-4cdd-9287-ababbf26d32a"
          },
          {
            "name": "Avg Monthly Charge",
            "displayFolder": "09 Customer 360",
            "expression": "AVERAGE ( dim_customer[monthly_charges] )",
            "formatString": "₹#,0",
            "lineageTag": "fa524fea-eef3-4f74-b55c-0850fb91ce64"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
